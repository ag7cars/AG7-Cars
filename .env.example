NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute path to a folder OUTSIDE this project's deployed code
# (e.g. a sibling folder on the server) where delivery videos are
# stored directly on disk instead of Supabase Storage — see
# lib/videoStorage.ts. Falls back to a local .video-storage/ folder
# in this project when unset, which is fine for local dev only.
VIDEO_STORAGE_DIR=

# Resend API key, "Sending access" permission — used by app/api/enquiry
# to email enquiries to info@ag7cars.com. Requires ag7cars.com to be a
# verified sending domain in the Resend dashboard.
RESEND_API_KEY=
